#!/bin/sh
# siigil-hook <working|waiting|done|end>  — stdin: il JSON del hook dell'agente, inoltrato com'è. Bundle: l'app che ospita il terminale, o $SIIGIL_BUNDLE se manca (l'app ChatGPT non lo passa). Pid: l'agente che chiama, per trovare l'app quando nessuno dei due c'è (Siigil, hostBundle).
# Mai output, sempre exit 0: lo stdout di UserPromptSubmit finirebbe nel contesto e un hook fallito non deve
# fermare l'agente. Se Siigil non gira, nc fallisce in silenzio; se gira chiude subito dopo la riga (~15 ms).
exec >/dev/null 2>&1
# Il payload contiene prompt e output dei tool: va solo a un socket creato da noi (un altro utente locale potrebbe
# occupare il path in /tmp prima di Siigil).
s="/tmp/siigil-$(id -u).sock"; [ -S "$s" ] && [ -O "$s" ] || exit 0
printf '{"agent":"%s","state":"%s","bundle":"%s","pid":%d,"payload":%s}\n' \
  "${SIIGIL_AGENT:-claude}" "$1" "${__CFBundleIdentifier:-$SIIGIL_BUNDLE}" "$PPID" "$(cat)" \
  | /usr/bin/nc -U -w 1 "$s"
exit 0
